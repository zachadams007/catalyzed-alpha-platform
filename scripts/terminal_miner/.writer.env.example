# Terminal wire writer - server-only secrets. Copy to `.writer.env` (gitignored)
# and fill in. These run on YOUR machine / a server, never in the client bundle.
#
#   cp scripts/terminal_miner/.writer.env.example scripts/terminal_miner/.writer.env
#
# The service-role key bypasses RLS - treat it like a password. The terminal_events
# table allows public SELECT only; every write must use this key server-side.

# --- Required: the cache write target (Supabase → Project Settings → API) ---
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-service-role-key

# --- Optional: unlock the keyed wire sources (else only the keyless SEC sources
#     run: 8-K + Form 4 insider). Reuse the same keys you have in .env. ---
FMP_API_KEY=
ALPACA_API_KEY=
ALPACA_API_SECRET=

# --- Optional: override the SEC fair-access contact User-Agent ---
# SEC_CONTACT=Your Name your-email@example.com
