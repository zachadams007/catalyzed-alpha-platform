# Daily broad-universe scan - secrets for a LOCAL run. Copy to `.scan.env`
# (gitignored) and fill in. In CI (GitHub Actions) these come from Action
# secrets / a generated .env instead - see .github/workflows/daily-universe.yml.
#
#   cp scripts/universe_scan/.scan.env.example scripts/universe_scan/.scan.env
#
# run_scan.ps1 loads this into the process env BEFORE vite-node, so the VITE_*
# keys override any stale values in the app's .env (Vite gives already-present
# process env vars priority). The service-role key bypasses RLS - treat as a
# password; it must NEVER reach the client bundle.

# --- Vendor keys (the scan fetches directly with these) ---
VITE_FINNHUB_API_KEY=
VITE_ALPACA_API_KEY=
VITE_ALPACA_API_SECRET=
# Optional - only used if you later route fundamentals through FMP.
VITE_FMP_API_KEY=
# Optional - doubles Finnhub throughput on a 429.
VITE_FINNHUB_API_KEY_2=

# --- Supabase (public client config for the engine + the write target) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-anon-key
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-service-role-key

# Optional non-secret override. The wrapper supplies the current git revision.
# LEARNING_ARCHIVE_ROOT=C:\path\to\immutable\learning-archive
