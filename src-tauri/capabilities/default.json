        { "url": "https://raw.githubusercontent.com/**" },
        { "url": "https://feeds.finance.yahoo.com/**" },
        { "url": "https://query1.finance.yahoo.com/**" },
        { "url": "https://query2.finance.yahoo.com/**" },
        { "url": "https://finance.yahoo.com/**" },
        { "url": "https://www.sec.gov/**" },
        { "url": "https://efts.sec.gov/**" },
        { "url": "https://data.sec.gov/**" },
        { "url": "https://financialmodelingprep.com/**" },
        { "url": "https://data.alpaca.markets/**" },
        { "url": "https://api.stocktwits.com/**" },
        { "url": "https://apewisdom.io/**" },
        { "url": "https://api.usaspending.gov/**" },
        { "url": "https://api.fda.gov/**" },
        { "url": "https://efdsearch.senate.gov/**" },
        { "url": "https://www.globenewswire.com/**" }
      ]
