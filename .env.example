# =============================================================================
# Catalyzed Alpha - environment template
# =============================================================================
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# With Finnhub + FMP keys set, use VITE_DATA_PROVIDER=hybrid for broad live
# discovery. Use mock for offline demo without API calls.
#
# Vite only exposes variables prefixed with VITE_ to the frontend bundle.
# Treat any key placed here as visible in the shipped desktop app - for
# production, proxy sensitive provider calls through a backend/edge function
# (see "Keys in a public bundle" in README.md) rather than embedding secret keys client-side.
# =============================================================================

# --- Active data provider --------------------------------------------------
# one of: mock | hybrid | finnhub | fmp | alphavantage | polygon
# Leave BLANK to auto-pick the broadest configured live provider.
VITE_DATA_PROVIDER=

# --- Finnhub (live quotes, news, analyst price targets) ---------------------
# 1. Create a free key at https://finnhub.io/register
# 2. Copy this file to `.env` in the project root (same folder as package.json)
# 3. Paste your key below and restart `npm run tauri dev`
#
# Powers: company news, street consensus price targets, analyst buy/hold/sell counts.
# The key is bundled into the desktop app (VITE_ prefix) - use a free-tier key only.
VITE_FINNHUB_API_KEY=

# --- Financial Modeling Prep (LIVE: niche screener discovery + price targets) -
# Free key: https://site.financialmodelingprep.com/developer/docs
# Powers: dynamic niche universe (small/micro caps beyond a fixed list),
# live fundamentals/ratios, and TipRanks-style consensus price targets that are
# BLENDED with Finnhub when both keys are present.
VITE_FMP_API_KEY=

# --- Other market data providers (stubs today) ------------------------------
VITE_ALPHAVANTAGE_API_KEY=
VITE_POLYGON_API_KEY=

# --- News / catalyst providers ---------------------------------------------
VITE_NEWSAPI_KEY=
VITE_MARKETAUX_API_KEY=

# --- Alpaca (real-time news wire - FREE with a paper account) ---------------
# Primary live headline source (Benzinga et al.) with direct article URLs.
# Needs BOTH the key id and secret. Create a paper account at
# https://app.alpaca.markets → API Keys. Bundled into the desktop app (VITE_),
# so use paper-trading keys only.
VITE_ALPACA_API_KEY=
VITE_ALPACA_API_SECRET=

# --- Social / political attention signals ----------------------------------
# Congressional-trade disclosures are pulled from the FREE, keyless House/Senate
# Stock Watcher datasets automatically - no key required. The keys below are for
# optional future Reddit/X/Quiver wiring.
VITE_REDDIT_CLIENT_ID=
VITE_REDDIT_CLIENT_SECRET=
VITE_QUIVER_API_KEY=

# --- Supabase (Friends tab - anon public key only; run supabase/migrations/0001_friends.sql) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Optional AI research agent (web research via YOUR server) --------------
# The desktop bundle must NOT hold LLM/search keys, so the agent runs in a
# Supabase Edge Function (supabase/functions/research-agent) and returns the
# ResearchIntel JSON contract (see src/data/ai/researchAgent.ts).
# Reference impl uses Google Gemini's FREE tier (no pay-per-use):
#   1. Free key: https://aistudio.google.com/apikey
#   2. supabase functions deploy research-agent --no-verify-jwt
#   3. supabase secrets set GEMINI_API_KEY=your_key
# When set, Blueprint shows "AI deep research" to expand themes with citations.
# Serves discover / theme_expand / price_targets / catalyst_extract (and
# deep_research, unless a dedicated desk below overrides it).
VITE_RESEARCH_PROXY_URL=

# --- Optional dedicated deep-research desk -----------------------------------
# Heavier per-ticker diligence service that ONLY answers task=deep_research.
# When set, deep_research routes here; all other tasks use the proxy above.
VITE_RESEARCH_DESK_URL=

# --- Research automation ----------------------------------------------------
# Local hour (0-23) the pre-market research job should target once wired.
VITE_RESEARCH_RUN_HOUR=6
